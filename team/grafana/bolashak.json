    {
      "id": 11,
      "type": "timeseries",
      "title": "CO на газоаналитических узлах, ppm",
      "datasource": {
        "type": "influxdb",
        "uid": "opentwins-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "query": "import \"dict\"\n\nnames = [\"bolashak:gs-480-c\": \"Узел околоствольного двора -480\", \"bolashak:gs-480-e\": \"Узел Восточного штрека -480\", \"bolashak:gs-480-o\": \"Узел подготовительного участка -480\", \"bolashak:gs-480-se\": \"Узел Юго-Восточного штрека -480\", \"bolashak:gs-480-r\": \"Узел вентиляционного штрека -480\", \"bolashak:gs-560-c\": \"Узел откаточного штрека -560\", \"bolashak:gs-560-p\": \"Узел очистного участка -560\", \"bolashak:gs-560-b\": \"Узел исходящей зарядной камеры -560\", \"bolashak:gs-560-r\": \"Узел вентиляционной сбойки -560\", \"bolashak:gs-640-c\": \"Узел откаточного штрека -640\", \"bolashak:gs-640-conv\": \"Узел конвейерного штрека -640\", \"bolashak:gs-640-p\": \"Узел очистного участка -640\", \"bolashak:gs-640-d\": \"Узел исходящей склада ГСМ -640\", \"bolashak:gs-640-r\": \"Узел вентиляционного штрека -640\", \"bolashak:gs-ramp\": \"Узел рампы -640 – -560\", \"bolashak:gs-vs\": \"Узел исходящей струи шахты (ГВУ)\", \"bolashak:shaft-cage\": \"Клетевой ствол\", \"bolashak:shaft-skip\": \"Скиповой ствол\", \"bolashak:shaft-vent\": \"Вентиляционный ствол\", \"bolashak:lhd-01\": \"ПДМ №1\", \"bolashak:lhd-02\": \"ПДМ №2\", \"bolashak:lhd-03\": \"ПДМ №3\", \"bolashak:truck-01\": \"Самосвал №1\", \"bolashak:truck-02\": \"Самосвал №2\", \"bolashak:truck-03\": \"Самосвал №3\"]\n\nfrom(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.thingId =~ /^bolashak:gs-/ and r._field == \"value_co_properties_value\")\n  |> map(fn: (r) => ({r with name: dict.get(dict: names, key: r.thingId, default: r.thingId)}))\n  |> keep(columns: [\"_time\", \"_value\", \"name\"])\n  |> group(columns: [\"name\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.name}",
          "unit": "ppm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8592a3",
                "value": null
              },
              {
                "color": "#e5a50a",
                "value": 17
              },
              {
                "color": "#ef4b4b",
                "value": 50
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "ПДК CO 17 ppm (0,0017 %, Приказ МЧС РК №352), уставка аварии 50 ppm"
    },
